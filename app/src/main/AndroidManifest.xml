<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--Aidl permissions self defined-->
    <permission android:name="com.mytvs.infotainmentcarhealthdigital.permission.ACCESS_DATA_SERVICE" />

    <application
        android:name="com.mytvs.infotainmentcarhealthdigital.MainApplicaiton"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InfotainmentCarHealthDigital"
        tools:targetApi="31">
        <activity
            android:name="com.mytvs.infotainmentcarhealthdigital.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.InfotainmentCarHealthDigital">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!--Receivers-->
        <receiver
            android:name=".view.widgetManager.TimeAndDateWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/date_and_time_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.MileageWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mileage_widget_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.RsaEmergencyWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rsa_emergency_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.VoltageWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_voltage_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.RSACallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rsa_call_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.VehicleHealthWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vehicle_health_widget_info" />
        </receiver>
        <receiver
            android:name=".view.widgetManager.WeeklyTripWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_trip_widget_info" />
        </receiver>

        <!--Services-->
        <service android:name=".serviceKit.SerialService" />
        <service
            android:name=".data.receivers.MyService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="location"
            android:label="My Service"
            android:stopWithTask="false"
            android:permission="com.mytvs.infotainmentcarhealthdigital.permission.ACCESS_DATA_SERVICE">
            <intent-filter>
                <action android:name="com.mytvs.infotainmentcarhealthdigital" />
            </intent-filter>
        </service>
        <service
            android:name=".serviceKit.USBService"
            android:enabled="true"
            android:exported="false" />

    </application>


</manifest>